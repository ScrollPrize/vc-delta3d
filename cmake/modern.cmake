# Shared native implementation; no dependency on Villa or Python.
find_package(Threads REQUIRED)
find_path(VC_ZSTD_INCLUDE_DIR zstd.h REQUIRED)
find_library(VC_ZSTD_LIBRARY NAMES zstd REQUIRED)
target_sources(vc_delta3d PRIVATE src/indexed.c src/ng/volcodec_ng_lib.c
    src/ng/ng_presets.c src/ng/ng_frame.c src/ng/ng_thresholds.c src/ng/ng_screen.c src/ng/ng_predict.c
    src/ng/ng_fit.c src/ng/ng_fast.c src/ng/ng_search.c src/ng/ng_medium.c src/ng/ng_stream.c src/ng/ng_rect.c
    src/ng/ng_select.c src/ng/ng_slow.c)
target_compile_definitions(vc_delta3d PRIVATE VC_DELTA3D_MODERN=1)
target_include_directories(vc_delta3d PRIVATE src src/ng "${VC_ZSTD_INCLUDE_DIR}")
target_link_libraries(vc_delta3d PRIVATE "${VC_ZSTD_LIBRARY}" Threads::Threads)
if(MSVC AND CMAKE_C_COMPILER_ID STREQUAL "Clang")
    # ClangCL does not automatically link compiler-rt's CPU detection state
    # used by __builtin_cpu_supports in the SIMD dispatch paths.
    execute_process(COMMAND "${CMAKE_C_COMPILER}" /clang:--print-runtime-dir
        OUTPUT_VARIABLE VC_CLANG_RUNTIME_DIR OUTPUT_STRIP_TRAILING_WHITESPACE
        COMMAND_ERROR_IS_FATAL ANY)
    find_library(VC_CLANG_BUILTINS NAMES clang_rt.builtins-x86_64
        PATHS "${VC_CLANG_RUNTIME_DIR}" NO_DEFAULT_PATH REQUIRED)
    target_link_libraries(vc_delta3d PRIVATE "${VC_CLANG_BUILTINS}")
endif()
if(NOT MSVC)
    target_compile_options(vc_delta3d PRIVATE $<$<COMPILE_LANGUAGE:C>:-std=gnu11> -ffp-contract=off)
    target_link_libraries(vc_delta3d PRIVATE m)
elseif(CMAKE_C_COMPILER_ID STREQUAL "Clang")
    target_compile_options(vc_delta3d PRIVATE $<$<COMPILE_LANGUAGE:C>:/clang:-std=gnu11>)
else()
    target_compile_options(vc_delta3d PRIVATE $<$<COMPILE_LANGUAGE:C>:/std:c11>)
endif()
foreach(dim IN ITEMS 32 64 128 256)
    add_library(vc_ng_fixed${dim} OBJECT src/ng/ng_fixed.c)
    set_property(TARGET vc_ng_fixed${dim} PROPERTY POSITION_INDEPENDENT_CODE ON)
    target_compile_definitions(vc_ng_fixed${dim} PRIVATE NG_FIXED_GEOMETRY=${dim} NG_BLOCK_DIM=${dim})
    if(NOT MSVC)
        target_compile_options(vc_ng_fixed${dim} PRIVATE -std=gnu11 -ffp-contract=off)
    elseif(CMAKE_C_COMPILER_ID STREQUAL "Clang")
        target_compile_options(vc_ng_fixed${dim} PRIVATE /clang:-std=gnu11 /clang:-ffp-contract=off)
    else()
        target_compile_options(vc_ng_fixed${dim} PRIVATE /std:c11)
    endif()
    target_sources(vc_delta3d PRIVATE $<TARGET_OBJECTS:vc_ng_fixed${dim}>)
endforeach()
option(VC_DELTA3D_MODERN_SMOKE "Build no-dependency integration smoke test" OFF)
if(VC_DELTA3D_MODERN_SMOKE)
    add_executable(vc_delta3d_c_api_tests tests/test_c_api.c)
    target_link_libraries(vc_delta3d_c_api_tests PRIVATE vc_delta3d)
    if(NOT MSVC)
        target_compile_options(vc_delta3d_c_api_tests PRIVATE -UNDEBUG)
    else()
        target_compile_options(vc_delta3d_c_api_tests PRIVATE /UNDEBUG)
    endif()
    add_test(NAME vc_delta3d_c_api_tests COMMAND vc_delta3d_c_api_tests)
    add_executable(vc_delta3d_modern_smoke tests/modern_smoke.cpp)
    target_link_libraries(vc_delta3d_modern_smoke PRIVATE vc_delta3d)
    if(NOT MSVC)
        target_compile_options(vc_delta3d_modern_smoke PRIVATE -UNDEBUG)
    endif()
endif()
